# Zugriff auf sensible Dateien verhindern.
# Das Muster deckt bewusst alle .env-Varianten ab (.env, .env.example, .env.deploy).
# conf.php gibt es im Projekt nicht mehr. Fruehe Versionen von deploy.sh haben aber
# nahezu alles hochgeladen und loeschen auf dem Server nie etwas - eine alte conf.php
# mit Zugangsdaten kann dort also noch liegen.
<FilesMatch "^(\.env.*|conf\.php|pg\.sql|deploy\.sh|.*\.md)$">
    Require all denied
</FilesMatch>

# Alle Pfade mit einem Punkt am Anfang eines Segments sperren (.git/, .claude/,
# .gitignore ...), ebenfalls Reste frueher Deployments. Ausgenommen ist .well-known/,
# das Let's Encrypt fuer die Zertifikatserneuerung braucht.
<IfModule mod_alias.c>
    RedirectMatch 404 "/\.(?!well-known/)"
</IfModule>

# Alle Aufrufe auf HTTPS umleiten. Erst damit bekommt das Session-Cookie sein
# Secure-Flag (start_secure_session() setzt es, sobald die Verbindung HTTPS ist).
# Der PHP-Entwicklungsserver ignoriert diese Datei, lokal bleibt http also nutzbar.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    # Steht ein Proxy davor, der TLS beendet, meldet Apache HTTPS=off obwohl der
    # Browser verschluesselt verbindet - ohne diese Zeile gaebe es eine Redirect-Schleife.
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Sicherheits-Header
<IfModule mod_headers.c>
    # Browser merken sich ein Jahr lang, die Seite nur per HTTPS aufzurufen.
    # Bewusst ohne includeSubDomains - weitere Subdomains koennten noch http brauchen.
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

    # Verhindert MIME-Sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Verhindert Einbettung in fremde Frames (Clickjacking)
    Header always set X-Frame-Options "DENY"
    # Referrer nur an die eigene Domain senden
    Header always set Referrer-Policy "same-origin"

    # Die Skripte in assets/ tragen ihre Version im Dateinamen. Ein Update bekommt
    # einen neuen Namen, deshalb duerfen Browser sie ein Jahr lang cachen.
    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# index.php als Standard-Startseite
DirectoryIndex index.php
