# Book Courts - Database Configuration
# Copy this file to .env, fill in real values, then run: chmod 600 .env
# Never commit .env to git.
#
# Values are taken literally: everything after the first '=' up to the end of the
# line. Characters like ; # " ' \ or umlauts need no escaping.
# Wrap a value in double quotes only if it starts or ends with a space.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=book_courts_test
DB_USER=sebastianwiller
DB_PASS=local
DB_SCHEMA=book_courts

# Maximum duration of a single booking for regular members, in minutes.
# Bookings use a 30-minute grid: values off the grid are rounded DOWN to the
# longest grid duration they contain (100 -> 90, 45 -> 30). At least 30, at most
# 720 (the admin limit). Leave empty or remove the line to keep the default of 60.
# Admins can always book up to 720 minutes.
MAX_BOOKING_MINUTES_USER=60
