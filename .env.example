; Book Courts - Database Configuration
; Copy this file to .env, fill in real values, then run: chmod 600 .env
; Never commit .env to git.
; If DB_PASS contains a semicolon (;), quote, backslash, or non-ASCII character,
; wrap the value in double quotes: DB_PASS="value with; special chars"
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
